        // ANIMATION LOOP
        function animate() {
            requestAnimationFrame(animate);
            const time = performance.now() * 0.001;

            // Smooth Camera Lerp + User Orbit Offset
            currentCamPos.lerp(targetCamPos, 0.05);
            currentLookAt.lerp(targetLookAt, 0.06);

            const offsetVec = currentCamPos.clone().sub(currentLookAt);
            offsetVec.applyAxisAngle(new THREE.Vector3(0, 1, 0), orbitOffset.theta);
            camera.position.copy(currentLookAt).add(offsetVec);
            camera.position.y += orbitOffset.phi * 5;
            camera.lookAt(currentLookAt);

            // Rotate AI Hologram Core
            if (aiCoreMesh) {
                aiCoreMesh.rotation.y = time * 0.8;
                aiCoreMesh.rotation.x = time * 0.4;
                aiRing1.rotation.z = time * 1.2;
                aiRing2.rotation.y = -time * 1.0;
            }

            // Animate Oven Fire Particles
            fireParticles.forEach(p => {
                p.position.y = p.userData.baseY + Math.sin(time * p.userData.speed + p.userData.offset) * 0.18;
            });

            // Subtle rotation on 3D Pizzas
            floatingPizzas.forEach((pz, i) => {
                pz.rotation.y = time * 0.3 + i;
            });

            // Animate Data Packets between POS Counter and AI Rack
            const startPos = new THREE.Vector3(-4.5, 2.1, -2.5);
            const endPos = new THREE.Vector3(7.2, 4.8, -6.5);
            dataPackets.forEach(pkt => {
                pkt.userData.progress = (pkt.userData.progress + pkt.userData.speed) % 1;
                const t = pkt.userData.progress;
                pkt.position.lerpVectors(startPos, endPos, t);
                pkt.position.y += Math.sin(t * Math.PI) * 2.2;
            });

            updateHotspotPositions();
            renderer.render(scene, camera);
        }

        // Initialize Everything on Load
        window.onload = function () {
            initThreeJS();
            renderSlide(0);
            animate();
        };
    </script>
</body>
</html>
