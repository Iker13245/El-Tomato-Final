                        <span>${s.shortName}</span>
                    </button>
                `;
            }).join('');

            // Animate 3D Camera to Station Target
            moveCameraTo(slide.camera.pos, slide.camera.target);
        }

        function nextSlide() {
            const next = (currentSlideIndex + 1) % slidesData.length;
            renderSlide(next);
        }

        function prevSlide() {
            const prev = (currentSlideIndex - 1 + slidesData.length) % slidesData.length;
            renderSlide(prev);
        }

        function goToSlide(index) {
            renderSlide(index);
        }

        function focusCurrentStation() {
            const slide = slidesData[currentSlideIndex];
            moveCameraTo(slide.camera.pos, slide.camera.target);
        }

